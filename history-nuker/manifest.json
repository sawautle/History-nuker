{
  "manifest_version": 3,
  "name": "History Nuker",
  "version": "1.0.0",
  "description": "If you haven't opened the browser in a while, assumes the worst and clears your history.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "history",
    "notifications"
  ],
  "optional_permissions": [
    "downloads"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "history-nuker@local.ext",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}